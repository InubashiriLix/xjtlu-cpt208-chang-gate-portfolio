@startuml
title Chang Gate Heritage - System Architecture

skinparam backgroundColor #fffdf8
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #2f8a7d
skinparam ComponentBorderColor #b7a98e
skinparam ComponentBackgroundColor #fff8ea
skinparam DatabaseBackgroundColor #eef7f5
skinparam DatabaseBorderColor #2f8a7d
skinparam CloudBackgroundColor #f8efe1
skinparam CloudBorderColor #c9872d

actor "Visitor" as User

node "Browser" {
  component "React App\nHashRouter" as ReactApp
  component "AppLayout\nHeader + Bottom Nav" as Layout
  component "Pages\nHome / Map / Gallery /\nSpot Detail / Postcard / Ask" as Pages
  component "Reusable Components\nSpotCard, SpotDetailCard,\nRouteTimeline, PostcardPreview,\nSectionTitle" as Components
  component "AppStateContext\nroute, language, location,\nchat messages" as State
  database "localStorage\nselected route + language" as LocalStorage
  component "Static Data Modules\nspots, routes, gallery,\npostcard themes" as Data
  folder "Bundled Assets\nspot photos, raw_img,\ncanal badge, poster PDF" as Assets
}

node "Vite Dev / Preview Server" as Vite {
  component "deepSeekProxyPlugin\n/api/deepseek" as Proxy
  database ".env\nVITE_AMAP_KEY\nVITE_AMAP_SECURITY_KEY\nAPI_KEY" as Env
}

cloud "External Services" {
  component "AMap JS API\nMap SDK + markers + polylines" as AMap
  component "DeepSeek Chat API\nroute-aware Ask response" as DeepSeek
}

cloud "GitHub Pages" as PagesHost {
  component "Static dist output\nHTML / CSS / JS / assets" as StaticHost
}

User --> ReactApp : opens app URL
ReactApp --> Layout : renders app shell
Layout --> Pages : renders current route
Pages --> Components : composes UI
Pages --> State : reads localized state
Components --> State : reads language-aware labels
State --> Data : localizes route and spot data
State <--> LocalStorage : persist language\nand selected route
Pages --> Assets : display photos\nand media

Pages --> AMap : load SDK using\nVITE_AMAP_KEY
Pages --> Proxy : POST Ask messages\nand progress JSON
Proxy --> Env : read API_KEY
Proxy --> DeepSeek : forward chat completion\nrequest
DeepSeek --> Proxy : response JSON
Proxy --> Pages : assistant message

ReactApp --> StaticHost : built by GitHub Actions\nand hosted as static files

note right of StaticHost
  GitHub Pages hosts the high-fi prototype.
  It does not run the Vite /api/deepseek
  middleware by itself.
end note

note right of State
  Core data handling:
  - content is bundled local data
  - language switches English / Chinese
  - distances are computed client-side
  - Ask receives route progress JSON
end note

@enduml
