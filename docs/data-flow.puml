@startuml
title Chang Gate Heritage - Data Flow

skinparam backgroundColor #fffdf8
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #fff8ea
skinparam ActivityBorderColor #b7a98e
skinparam ArrowColor #2f8a7d
skinparam DiamondBackgroundColor #eef7f5
skinparam DiamondBorderColor #2f8a7d

start
:Visitor opens the app;
:HashRouter selects page route;

fork
  :Load bundled React JavaScript;
  :Render AppLayout;
fork again
  :Read localStorage;
  :Restore language and selected route;
fork again
  :Load static data modules;
  :spots, routes, gallery views,\npostcard themes;
end fork

:AppStateContext derives shared state;
:Localize spots and routes\nfor English or Chinese;
:Calculate demo/current distance\nwith haversine formula;

if (Current page?) then (Home)
  :Render hero, nearby spots,\nfeature goals, route preview,\npostcard teaser;
elseif (Map)
  :Read VITE_AMAP_KEY and\nVITE_AMAP_SECURITY_KEY;
  :Load AMap JS SDK;
  :Draw markers and route polylines;
  :Show next-stop info window\nand ordered stop list;
elseif (Spot Detail)
  :Find spot by URL slug;
  :Render image hero, story,\nnoticing prompts, next route stop;
elseif (Gallery)
  :Render local field photos\nand bilingual descriptions;
elseif (Postcard)
  :Choose theme, image crop,\nfavorite spot, message;
  :Render preview;
  :Export PNG with Canvas API;
else (Ask)
  :Build progress JSON from\ncurrent route and localized spots;
  :Send POST /api/deepseek;
  :Vite proxy reads API_KEY\nfrom .env;
  :DeepSeek returns assistant answer\nin selected language;
endif

:Update UI state;
:Persist language/route changes\nto localStorage;
stop

@enduml
